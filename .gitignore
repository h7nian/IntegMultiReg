# === Compiled C objects / shared libraries (regenerated at install time) ===
src/*.o
src/*.so
src/*.dll
src/symbols.rds

# === Files generated by ./configure (templates Makevars.in / Makevars.win are kept) ===
src/Makevars
config.log
config.status
autom4te.cache/

# === Raw data download cache (very large; regenerated by data-raw/*.R) ===
data-raw/cache/

# === R session / build artefacts ===
.Rproj.user/
*.Rproj
.Rhistory
.RData
.Rapp.history
.Ruserdata
*.Rcheck/
*.tar.gz

# === OS / editor junk ===
.DS_Store
.vscode/
*~
