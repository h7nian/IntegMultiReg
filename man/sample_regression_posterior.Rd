\deqn{W=\frac{1}{M}\sum_c s_c^2,}{W = mean of the M within-sequence variances,}
\deqn{B=\frac{H}{M-1}\sum_c(\bar q_c-\bar q)^2,}{B = H * sum_c (mean_q_c - overall_mean_q)^2 / (M - 1),}
