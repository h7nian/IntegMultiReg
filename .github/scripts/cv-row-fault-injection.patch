   *allocation_failed = 0;
+  test_rows_reset();
   if (!postfit_rows_init(&prediction_rows, max_models, test_sample_size,
-                         model_representatives, malloc, free)) {
+                         model_representatives, test_rows_malloc, test_rows_free)) {
     *allocation_failed = 1;
     return NULL;
